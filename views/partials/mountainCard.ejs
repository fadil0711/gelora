<a href="/mountains/<%= mountain.id %>" class="card reveal">
  <div class="card-media">
    <div class="card-tags">
      <span class="tag"><%= mountain.difficulty() %></span>
      <span class="tag <%= mountain.trailStatus === 'Tutup' ? 'tag-shut' : (mountain.trailStatus === 'Buka Terbatas' ? 'tag-warn' : '') %>">
        Jalur <%= mountain.trailStatus %>
      </span>
    </div>
    <img src="<%= mountain.imgUrl %>" alt="Pemandangan <%= mountain.name %>" loading="lazy">
  </div>
  <div class="card-body">
    <h3><%= mountain.name %></h3>
    <span class="where"><%= mountain.location %></span>
    <div class="gauge">
      <div class="gauge-top">
        <b class="num"><%= mountain.heightFormatted %></b>
        <span class="num"><%= mountain.elevationPercent %>% Kerinci</span>
      </div>
      <div class="gauge-rail"><div class="gauge-fill" style="width: <%= mountain.elevationPercent %>%"></div></div>
    </div>
  </div>
</a>

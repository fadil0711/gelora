          <a href="/mountains/add" class="btn btn-line btn-sm">Tambah gunung</a>
        <% } %>
        <a href="/logout" class="btn btn-moss btn-sm">Keluar</a>
      <% } else { %>
        <a href="/login" class="btn btn-line btn-sm">Masuk</a>
        <a href="/register" class="btn btn-sun btn-sm">Buat akun</a>
      <% } %>
    </div>
  </div>
